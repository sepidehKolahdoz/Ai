const axios = require("axios");
const fs = require("fs");
const path = require("path");

const swaggerUrl = "https://rad-sandbox.sandpod.ir/docs?api-docs.json";
const outputDir = path.join(process.cwd(), "generated");

// =======================
// Load Swagger
// =======================
async function getSwagger() {
  const res = await axios.get(swaggerUrl);
  return res.data;
}

// =======================
// دقیقا مثل generator اصلی
// =======================
function safeDisplayName(apiPath) {
  return apiPath
    .replace(/[{}\/\\]/g, "-")
    .replace(/^-+|-+$/g, "");
}

// =======================
// ساخت کلید یکتا
// =======================
function buildKey(method, apiPath) {
  const clean = safeDisplayName(apiPath);
  return `${method.toUpperCase()}_${clean}`.toUpperCase();
}

// =======================
// خواندن فایل‌های واقعی پروژه
// =======================
function getExistingFiles() {
  const existing = new Set();

  if (!fs.existsSync(outputDir)) return existing;

  const modules = fs.readdirSync(outputDir);

  modules.forEach(moduleName => {
    const featureDir = path.join(outputDir, moduleName, "features");

    if (!fs.existsSync(featureDir)) return;

    const files = fs.readdirSync(featureDir);

    files.forEach(file => {
      if (file.endsWith(".feature")) {
        const name = file.replace(".feature", "").toUpperCase();
        existing.add(name);
      }
    });
  });

  return existing;
}

// =======================
// ساخت فایل (کاملاً safe)
// =======================
function createFiles(endpoint) {

  const moduleName = endpoint.tag.replace(/\s+/g, "-").toLowerCase();
  const moduleDir = path.join(outputDir, moduleName);
  const featureDir = path.join(moduleDir, "features");
  const stepDir = path.join(moduleDir, "steps");

  [moduleDir, featureDir, stepDir].forEach(d => {
    if (!fs.existsSync(d)) fs.mkdirSync(d, { recursive: true });
  });

  const clean = safeDisplayName(endpoint.path);
  const baseName = `${endpoint.method}_${clean}`;

  const featureFile = path.join(featureDir, `${baseName}.feature`);
  const stepFile = path.join(stepDir, `${baseName}.js`);

  // 🛑 جلوگیری قطعی از overwrite
  if (fs.existsSync(featureFile) || fs.existsSync(stepFile)) {
    console.log(`⏭ SKIPPED (already exists): ${baseName}`);
    return;
  }

  const featureContent = `
Feature: ${endpoint.method} ${endpoint.path}

  Scenario: ${endpoint.method} ${endpoint.path}
    Given I have a valid access token
    When I execute ${baseName}
    Then the response status should be 200
`;

  const stepContent = `
// AUTO-GENERATED NEW API
// ${endpoint.method} ${endpoint.path}
`;

  fs.writeFileSync(featureFile, featureContent.trim());
  fs.writeFileSync(stepFile, stepContent.trim());

  console.log(`✅ NEW API CREATED: ${baseName}`);
}

// =======================
// MAIN
// =======================
async function syncNewApis() {

  console.log("\n========= SYNC NEW APIS =========\n");

  const swagger = await getSwagger();
  const existingFiles = getExistingFiles();

  for (const [apiPath, methods] of Object.entries(swagger.paths)) {

    for (const [method, operation] of Object.entries(methods)) {

      const normalizedMethod = method.toUpperCase();
      const key = buildKey(normalizedMethod, apiPath);

      if (existingFiles.has(key)) {
        console.log(`⏭ EXISTS: ${key}`);
        continue;
      }

      createFiles({
        method: normalizedMethod,
        path: apiPath,
        tag: (operation.tags && operation.tags[0]) || "general"
      });
    }
  }

  console.log("\n🎯 DONE - Only missing APIs added\n");
}

syncNewApis().catch(console.error);



